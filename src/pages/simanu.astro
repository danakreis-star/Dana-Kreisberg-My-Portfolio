---
import Nav from '../components/Nav.astro';
---

<html lang="en">
<head>
  <meta charset="utf-8">
  <title>SIMANU — Dana Kreisberg</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap');

/* ─── TOKENS ─── */
:root {
  --paper:     #ffffff;
  --paper-2:   #f2f2f2;
  --ink:       oklch(14% 0.01 240);
  --ink-60:    oklch(14% 0.01 240 / 0.62);
  --ink-40:    oklch(14% 0.01 240 / 0.42);
  --rule:      oklch(14% 0.01 240 / 0.14);
  --rule-soft: oklch(14% 0.01 240 / 0.08);
  --display:   "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --body:      "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --mono:      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --gutter:    8%;
}

/* ─── RESET ─── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }

body {
  font-family: var(--body);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ════════════════════════════
   TITLE
════════════════════════════ */
.title-section { padding: 64px var(--gutter) 56px; }
.title-meta {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
  margin-bottom: 20px;
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
}
.cs-h1 {
  font-family: var(--display);
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.95;
  letter-spacing: -0.04em;
  margin: 0;
  font-weight: 400;
}
.cs-h1 em { font-style: italic; font-weight: 100; }
.lede {
  margin-top: 32px;
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink-60);
  max-width: 62ch;
}

/* ════════════════════════════
   VIDEO EMBED
════════════════════════════ */
.video-wrap {
  padding: 0 var(--gutter) 64px;
}
.video-embed {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  background: #000;
  border-radius: 12px;
  overflow: hidden;
}
.video-embed iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
}

/* ════════════════════════════
   IMAGE GALLERY
════════════════════════════ */
.gallery {
  padding: 0 var(--gutter) 100px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.gallery-row {
  display: grid;
  gap: 16px;
}
.gallery-row--1 { grid-template-columns: 1fr; }
.gallery-row--2 { grid-template-columns: 1fr 1fr; }
.gallery-row--3 { grid-template-columns: 1fr 1fr 1fr; }

.gallery-img {
  width: 100%;
  display: block;
  border-radius: 10px;
}

/* ════════════════════════════
   RESPONSIVE
════════════════════════════ */
@media (max-width: 900px) {
  :root { --gutter: 5%; }
}
@media (max-width: 600px) {
  :root { --gutter: 20px; }
  .gallery-row--2,
  .gallery-row--3 { grid-template-columns: 1fr; }
}
  </style>
</head>
<body>
<Nav />

<!-- ── HERO ── -->
<section class="title-section">
  <div class="title-meta">
    <span>SIMANU</span>
    <span>Final project · Bezalel Academy · 2016</span>
  </div>
  <h1 class="cs-h1">SIMANU —<br><em>Hebrew Calendar</em></h1>
  <p class="lede">A graduation project exploring the visual language of the Hebrew calendar. SIMANU examines time, ritual, and cultural memory through editorial design and typographic systems.</p>
</section>

<!-- ── VIDEO ── -->
<div class="video-wrap">
  <div class="video-embed">
    <iframe src="https://player.vimeo.com/video/173680992?title=0&byline=0&portrait=0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
  </div>
</div>

<!-- ── GALLERY ── -->
<div class="gallery">

  <div class="gallery-row gallery-row--1">
    <img class="gallery-img" src="/images/Simanu-01.png" alt="SIMANU" />
  </div>

  <div class="gallery-row gallery-row--2">
    <img class="gallery-img" src="/images/Simanu-02.gif" alt="SIMANU" />
    <img class="gallery-img" src="/images/Simanu-03.gif" alt="SIMANU" />
  </div>

  <div class="gallery-row gallery-row--2">
    <img class="gallery-img" src="/images/Simanu-04.gif" alt="SIMANU" />
    <img class="gallery-img" src="/images/Simanu-05.gif" alt="SIMANU" />
  </div>

  <div class="gallery-row gallery-row--2">
    <img class="gallery-img" src="/images/Simanu-06.gif" alt="SIMANU" />
    <img class="gallery-img" src="/images/Simanu-07.png" alt="SIMANU" />
  </div>

  <div class="gallery-row gallery-row--1">
    <img class="gallery-img" src="/images/Simanu-08.gif" alt="SIMANU" />
  </div>

</div>

</body>
</html>
