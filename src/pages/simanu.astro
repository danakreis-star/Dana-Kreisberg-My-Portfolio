---
import Nav from '../components/Nav.astro';
---

<html lang="en">
<head>
  <meta charset="utf-8">
  <title>SIMANU — Dana Kreisberg</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap');

/* ─── TOKENS ─── */
:root {
  --paper:     #ffffff;
  --paper-2:   #f2f2f2;
  --ink:       oklch(14% 0.01 240);
  --ink-60:    oklch(14% 0.01 240 / 0.62);
  --ink-40:    oklch(14% 0.01 240 / 0.42);
  --rule:      oklch(14% 0.01 240 / 0.14);
  --rule-soft: oklch(14% 0.01 240 / 0.08);
  --display:   "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --body:      "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --mono:      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --gutter:    8%;
}

/* ─── RESET ─── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }

body {
  font-family: var(--body);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ════════════════════════════
   TITLE
════════════════════════════ */
.title-section { padding: 64px var(--gutter) 56px; }
.title-meta {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
  margin-bottom: 20px;
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
}
.cs-h1 {
  font-family: var(--display);
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.95;
  letter-spacing: -0.04em;
  margin: 0;
  font-weight: 400;
}
.cs-h1 em { font-style: italic; font-weight: 100; }
.lede {
  margin-top: 32px;
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink-60);
  max-width: 62ch;
}

/* ════════════════════════════
   VIDEO EMBED
════════════════════════════ */
.video-wrap {
  padding: 0 var(--gutter) 24px;
}
.video-embed {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  background: #000;
  border-radius: 12px;
  overflow: hidden;
}
.video-embed iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
}

/* ════════════════════════════
   IMAGE GALLERY
════════════════════════════ */
.gallery {
  padding: 0 var(--gutter) 100px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.gallery-row {
  display: grid;
  gap: 16px;
}
.gallery-row--1 { grid-template-columns: 1fr; }
.gallery-row--2 { grid-template-columns: 1fr 1fr; }
.gallery-row--3 { grid-template-columns: 1fr 1fr 1fr; }

.gallery-img {
  width: 100%;
  display: block;
  border-radius: 10px;
}
.gallery-figure {
  min-width: 0;
}
.gallery-caption {
  margin-top: 12px;
  max-width: 58ch;
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink-60);
}
.gallery-caption strong {
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
}

/* ════════════════════════════
   RESPONSIVE
════════════════════════════ */
@media (max-width: 900px) {
  :root { --gutter: 5%; }
}
@media (max-width: 600px) {
  :root { --gutter: 20px; }
  .gallery-row--2,
  .gallery-row--3 { grid-template-columns: 1fr; }
}
  </style>
</head>
<body>
<Nav />

<!-- ── HERO ── -->
<section class="title-section">
  <div class="title-meta">
    <span>SIMANU</span>
    <span>Final project · Bezalel Academy · 2016</span>
  </div>
  <h1 class="cs-h1">SIMANU —<br><em>Hebrew Calendar</em></h1>
  <p class="lede">A graduation project exploring the visual language of the Hebrew calendar. SIMANU examines time, ritual, and cultural memory through editorial design and typographic systems.</p>
</section>

<!-- ── VIDEO ── -->
<div class="video-wrap">
  <div class="video-embed">
    <iframe src="https://player.vimeo.com/video/173680992?title=0&byline=0&portrait=0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
  </div>
</div>

<!-- ── INTRO TEXT ── -->
<div style="max-width: 720px; margin: 24px auto 0; padding: 0 var(--gutter);">
  <h2 style="font-family: var(--display); font-size: clamp(20px, 2.5vw, 28px); font-weight: 400; letter-spacing: -0.02em; line-height: 1.25; color: var(--ink); margin: 0 0 20px;">Bringing the rhythms of traditional time into everyday life</h2>
  <p style="font-family: var(--body); font-size: 17px; line-height: 1.65; color: var(--ink-60); margin: 0;">SIMANU can be experienced at different scales: as a complete year, a single month, or an individual day. The calendar becomes a living object for the home—one that can be displayed, rearranged, and used, while connecting everyday life to the wider cycles unfolding throughout the year.</p>
</div>

<!-- ── GALLERY ── -->
<div class="gallery">

  <div class="gallery-row gallery-row--1">
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-01.png" alt="SIMANU visual language key" />
      <figcaption class="gallery-caption"><strong>The visual language</strong><br>Each Hebrew month is represented by a symbol assembled from seasonal phenomena, agricultural activity, and religious or cultural rituals. Colour marks the agricultural cycle; line icons mark the practices and traditions of the time.</figcaption>
    </figure>
  </div>

  <div class="gallery-row gallery-row--2">
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-02.gif" alt="SIMANU month view" />
      <figcaption class="gallery-caption"><strong>Month view</strong><br>A monthly symbol makes the rhythms of the season visible: what is changing outside, what is being cultivated, and what the calendar asks us to remember.</figcaption>
    </figure>
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-03.gif" alt="SIMANU month view interaction" />
      <figcaption class="gallery-caption"><strong>Living symbols</strong><br>The compositions shift from month to month, allowing the calendar to be experienced as a living system rather than a fixed grid of dates.</figcaption>
    </figure>
  </div>

  <div class="gallery-row gallery-row--2">
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-04.gif" alt="SIMANU calendar navigation" />
      <figcaption class="gallery-caption"><strong>Changing scale</strong><br>The interface lets people move between a single month and the larger annual cycle, depending on how they want to read time.</figcaption>
    </figure>
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-05.gif" alt="SIMANU year view" />
      <figcaption class="gallery-caption"><strong>Year view</strong><br>Twelve monthly symbols become one visual map of the Hebrew year — a glanceable overview of its changing seasons and occasions.</figcaption>
    </figure>
  </div>

  <div class="gallery-row gallery-row--2">
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-06.gif" alt="SIMANU day view" />
      <figcaption class="gallery-caption"><strong>Day view</strong><br>A date can hold personal notes alongside the calendar's cultural context, making the object useful in everyday life as well as reflective.</figcaption>
    </figure>
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-07.png" alt="SIMANU ritual and tradition view" />
      <figcaption class="gallery-caption"><strong>Ritual in context</strong><br>Religious and traditional events come into focus within the date itself, connecting individual days to the stories and practices that shape them.</figcaption>
    </figure>
  </div>

  <div class="gallery-row gallery-row--1">
    <figure class="gallery-figure">
      <img class="gallery-img" src="/images/Simanu-08.gif" alt="SIMANU printed book" />
      <figcaption class="gallery-caption"><strong>Beyond the screen</strong><br>SIMANU was conceived as an object for the home — a calendar to hang, revisit, and use as a bridge between modern routines and the traditional rhythm of the year.</figcaption>
    </figure>
  </div>

</div>

<!-- ── PDF LINK ── -->
<div style="padding: 0 var(--gutter) 80px; border-top: 1px solid var(--rule); margin-top: 0; padding-top: 32px;">
  <span style="font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-40); display: block; margin-bottom: 12px;">Full book</span>
  <a href="https://drive.google.com/file/d/1pyUCRSegVPB7azb6Wu5D9zaTECGekksy/view?usp=sharing"
     target="_blank"
     rel="noopener"
     style="font-family: var(--display); font-size: 18px; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink); padding-bottom: 2px; display: inline-block;">
    Chapters_in_Time_Dana_Kreisberg_2016.pdf ↗
  </a>
</div>

</body>
</html>
