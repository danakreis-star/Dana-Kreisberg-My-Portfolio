<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
<script is:inline>
(function () {
  if (!window.Matter) return;
  const container = document.getElementById('heroTagsPhysics');
  if (!container) return;
  const pills = [...container.querySelectorAll('.hero-tag-pill')];
  if (!pills.length) return;

  pills.forEach(el => { el.style.visibility = 'hidden'; });
  const sizes = pills.map(el => ({ w: el.offsetWidth, h: el.offsetHeight }));

  const { Engine, Bodies, Composite, Events, Body, Sleeping } = Matter;
  const cw = container.offsetWidth;
  const ch = container.offsetHeight;

  // Reduced-motion: row layout immediately, no animation or physics
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const GAP = 10; let rx = 0;
    pills.forEach((el, i) => {
      const s = sizes[i];
      el.style.transform = `translate(${rx}px,${ch - s.h - 4}px)`;
      el.style.visibility = 'visible';
      rx += s.w + GAP;
    });
    wireFilters();
    return;
  }

  const engine = Engine.create({ gravity: { y: 8.0 }, enableSleeping: true });

  const W = 60;
  const floorY = ch - 4;
  Composite.add(engine.world, [
    Bodies.rectangle(cw / 2, floorY + W / 2, cw + W * 2, W, { isStatic: true, friction: 0.6, restitution: 0.05 }),
    Bodies.rectangle(-W / 2, ch / 2, W, ch * 6, { isStatic: true, friction: 0.3, restitution: 0 }),
    Bodies.rectangle(cw + W / 2, ch / 2, W, ch * 6, { isStatic: true, friction: 0.3, restitution: 0 }),
  ]);

  const entered = new Array(pills.length).fill(false);

  // Pills distributed across the full width so they settle in max 2 rows, flowing left → right
  const physBodies = sizes.map((s, i) => {
    const startX = i === 0
      ? s.w / 2 + 2
      : s.w / 2 + 6 + Math.random() * (cw * 0.40);
    const startY = -s.h / 2 - 10 - i * 40;
    const body = Bodies.rectangle(startX, startY, s.w, s.h, {
      restitution: 0,        // no bounce — pills thud and stay
      friction: 0.08,
      frictionAir: 0.05,
      frictionStatic: 0.1,
      sleepThreshold: 60,
      angle: (Math.random() - 0.5) * 0.06,
    });
    Body.setInertia(body, body.inertia * 4);
    return body;
  });
  Composite.add(engine.world, physBodies);
  pills.forEach(el => { el.style.visibility = 'visible'; });

  const MAX_TILT = Math.PI / 10; // ~18° — pills stay mostly flat

  // After the initial fall settles, start drifting pills rightward into a row
  let flatMode = false;

  // ── DRAG INTERACTION ──────────────────────────────────────
  let drag = null; // active drag state

  function pointerPos(e) {
    const rect = container.getBoundingClientRect();
    const src = e.touches ? e.touches[0] : e;
    return { x: src.clientX - rect.left, y: src.clientY - rect.top };
  }

  pills.forEach((pill, i) => {
    const body = physBodies[i];
    pill.style.cursor = 'grab';

    function onDown(e) {
      e.preventDefault();
      const { x, y } = pointerPos(e);
      drag = {
        body, pill, index: i,
        offsetX: x - body.position.x,
        offsetY: y - body.position.y,
        startX: x, startY: y,
        velX: 0, velY: 0,
        lastX: x, lastY: y, lastT: Date.now(),
        moved: false,
      };
      Sleeping.set(body, false);
      Body.setVelocity(body, { x: 0, y: 0 });
      Body.setAngularVelocity(body, 0);
      pill.style.cursor = 'grabbing';
      pill.style.zIndex = '90';
    }

    pill.addEventListener('mousedown', onDown);
    pill.addEventListener('touchstart', onDown, { passive: false });
  });

  function onMove(e) {
    if (!drag) return;
    if (e.cancelable) e.preventDefault();
    const { x, y } = pointerPos(e);
    const dx = x - drag.startX, dy = y - drag.startY;
    if (!drag.moved && dx * dx + dy * dy > 25) drag.moved = true;
    if (!drag.moved) return;

    const now = Date.now();
    const dt = Math.max(16, now - drag.lastT); // min 16ms prevents enormous velocity on fast moves
    drag.velX = Math.max(-18, Math.min(18, (x - drag.lastX) / dt * 16));
    drag.velY = Math.max(-18, Math.min(18, (y - drag.lastY) / dt * 16));
    drag.lastX = x; drag.lastY = y; drag.lastT = now;

    // Clamp drag position to container bounds so pills can't escape the walls
    const clampedX = Math.max(sizes[drag.index].w / 2, Math.min(cw - sizes[drag.index].w / 2, x - drag.offsetX));
    const clampedY = Math.max(sizes[drag.index].h / 2, Math.min(floorY - sizes[drag.index].h / 2, y - drag.offsetY));
    Body.setPosition(drag.body, { x: clampedX, y: clampedY });
    Body.setVelocity(drag.body, { x: drag.velX, y: drag.velY });
  }

  function onUp() {
    if (!drag) return;
    if (!drag.moved) {
      // Was a tap/click — toggle filter
      drag.pill.classList.toggle('active');
      const activeTags = pills.filter(p => p.classList.contains('active')).map(p => p.dataset.filter);
      if (activeTags.length) enterFlatMode();
      filterProjects(activeTags.length ? activeTags : null);
    } else {
      // Release with throw velocity and wake the body so gravity continues
      Sleeping.set(drag.body, false);
      Body.setVelocity(drag.body, { x: drag.velX, y: drag.velY });
    }
    drag.pill.style.cursor = 'grab';
    drag.pill.style.zIndex = '';
    drag = null;
  }

  document.addEventListener('mousemove', onMove);
  document.addEventListener('mouseup', onUp);
  document.addEventListener('touchmove', onMove, { passive: false });
  document.addEventListener('touchend', onUp);
  document.addEventListener('touchcancel', onUp);

  // ── PHYSICS LOOP (runs forever) ───────────────────────────
  (function loop() {
    Engine.update(engine, 1000 / 60 / 3);
    Engine.update(engine, 1000 / 60 / 3);
    Engine.update(engine, 1000 / 60 / 3);
    physBodies.forEach((body, i) => {
      const s = sizes[i];
      const { x, y } = body.position;
      const isDragged = drag && drag.index === i;

      if (!isDragged) {
        // Once entered, prevent flying back above container
        if (!entered[i] && y >= -s.h / 2) entered[i] = true;
        if (entered[i] && y < s.h / 2) {
          Body.setPosition(body, { x, y: s.h / 2 });
          Body.setVelocity(body, { x: body.velocity.x, y: Math.max(body.velocity.y, 0) });
        }

        // Damp angular velocity aggressively
        Body.setAngularVelocity(body, body.angularVelocity * 0.7);

        // Hard clamp on rotation
        let a = body.angle % (2 * Math.PI);
        if (a > Math.PI) a -= 2 * Math.PI;
        if (a < -Math.PI) a += 2 * Math.PI;
        if (Math.abs(a) > MAX_TILT) {
          Body.setAngle(body, Math.sign(a) * MAX_TILT);
          Body.setAngularVelocity(body, 0);
        }

        // Floor clamp — pills can never go below the baseline
        const restY = floorY - s.h / 2;
        if (body.position.y > restY + 1) {
          Body.setPosition(body, { x: body.position.x, y: restY });
          Body.setVelocity(body, { x: body.velocity.x, y: 0 });
        }

        // Straighten all pills toward angle 0; only freeze angular velocity once on the floor
        const ang = body.angle;
        const onFloor = body.position.y >= restY - 3;
        if (Math.abs(ang) > 0.01) Body.setAngle(body, ang * 0.85);
        else Body.setAngle(body, 0);
        if (onFloor) Body.setAngularVelocity(body, 0);

        // Anti-float: only floor pills may sleep; anything airborne stays awake
        if (body.isSleeping && !onFloor) {
          Sleeping.set(body, false);
        }

      }

      const el = pills[i];
      if (!flatMode) {
        if (!isDragged) el.style.zIndex = String(Math.round(50 - body.position.y / 100));
        el.style.transform = `translate(${body.position.x}px,${body.position.y}px) rotate(${body.angle}rad) translate(${-s.w / 2}px,${-s.h / 2}px)`;
      }
    });
    requestAnimationFrame(loop);
  })();

  function enterFlatMode() {
    if (flatMode) return;
    flatMode = true;
    container.classList.add('flat-mode');
    pills.forEach(p => { p.style.transform = ''; p.style.zIndex = ''; });
  }

  const clearBtn = container.querySelector('.pill-clear');
  clearBtn?.addEventListener('click', () => {
    pills.forEach(p => p.classList.remove('active'));
    filterProjects(null);
  });

  function filterProjects(tags) {
    const allTagged = document.querySelectorAll('[data-tags]');
    allTagged.forEach(el => {
      if (!tags) {
        el.classList.remove('filtered-out');
      } else {
        const elTags = el.dataset.tags.split(' ');
        el.classList.toggle('filtered-out', !tags.some(t => elTags.includes(t)));
      }
    });
    // Show/hide section headings based on whether any items are visible
    const worksSection = document.querySelector('.works');
    const moreSection = document.querySelector('.more-work');
    if (worksSection) {
      const anyVisible = [...worksSection.querySelectorAll('[data-tags]')].some(el => !el.classList.contains('filtered-out'));
      worksSection.style.display = anyVisible ? '' : 'none';
    }
    if (moreSection) {
      const anyVisible = [...moreSection.querySelectorAll('[data-tags]')].some(el => !el.classList.contains('filtered-out'));
      moreSection.style.display = anyVisible ? '' : 'none';
    }
  }
})();
</script>

</body>
