---
import Nav from '../components/Nav.astro';
---

<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Dana Kreisberg — Portfolio</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style>

/* ── TOKENS ── */
:root {
  --paper:     #ffffff;
  --paper-2:   #f2f2f2;
  --ink:       oklch(14% 0.01 240);
  --ink-60:    oklch(14% 0.01 240 / 0.62);
  --ink-40:    oklch(14% 0.01 240 / 0.42);
  --rule:      oklch(14% 0.01 240 / 0.14);
  --rule-soft: oklch(14% 0.01 240 / 0.08);
  --accent:    oklch(58% 0.14 250);
  --stripe-a:  oklch(92% 0.004 240);
  --stripe-b:  oklch(89% 0.005 240);
  --display:   "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --body:      "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --mono:      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --gutter:    8%;
  --radius:    30px;
}

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { margin: 0; padding: 0; }
a { color: inherit; text-decoration: none; }

body {
  font-family: var(--body);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ── UTILITIES ── */
.meta {
  font-family: var(--body);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-60);
  font-weight: 500;
}
.mono {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.02em;
  color: var(--ink-40);
}
.rule  { height: 1px; background: var(--rule);     border: 0; margin: 0; display: block; }
.rule-s{ height: 1px; background: var(--rule-soft); border: 0; margin: 0; display: block; }

/* ── PLACEHOLDER ── */
.ph {
  position: relative;
  background-image: repeating-linear-gradient(
    135deg,
    var(--stripe-a) 0 14px,
    var(--stripe-b) 14px 28px
  );
  overflow: hidden;
  border-radius: var(--radius);
  width: 100%;
}

.ar-16-10 { aspect-ratio: 16 / 10; }
.ar-4-3   { aspect-ratio: 4 / 3; }
.ar-3-2   { aspect-ratio: 3 / 2; }
.ar-16-9  { aspect-ratio: 16 / 9; }

.project-thumb {
  width: 88%;
  height: auto;
  display: block;
  border-radius: var(--radius);
}

.ph img {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center top !important;
  display: block !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* ── HERO ── */
.hero { padding: 80px var(--gutter) 100px; }
.hero-title {
  font-family: var(--display);
  font-size: clamp(40px, 5.6vw, 96px);
  line-height: 1.02;
  letter-spacing: -0.035em;
  font-weight: 400;
  max-width: 16ch;
}
.hero-title em { font-style: italic; font-family: var(--display); font-weight: 100 !important; }
.hero-bottom {
  margin-top: 72px;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 64px;
  align-items: start;
}
.hero-tags {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  font-family: var(--display);
  font-size: 20px;
  letter-spacing: -0.01em;
  margin-top: 32px;
}
.tag-div { color: var(--ink-40); }
.hero-lede { font-size: 17px; line-height: 1.55; color: var(--ink-60); max-width: 62ch; }

/* ── WORKS HEADER ── */
.works-header { display: flex; justify-content: space-between; padding: 16px var(--gutter) 56px; }

/* ── FEATURED PROJECTS ── */
.works { padding: 0 var(--gutter); display: flex; flex-direction: column; gap: 80px; }
.project-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--rule);
  padding: 14px 0 28px;
}
.project-meta-left {
  display: flex;
  align-items: center;
  gap: 16px;
}
.project-media { margin-bottom: 24px; }
.project-foot {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 48px;
  align-items: end;
}
.project-title {
  font-family: var(--display);
  font-size: clamp(36px, 4.4vw, 72px);
  letter-spacing: -0.03em;
  line-height: 1;
  font-weight: 400;
}
.project-sub { margin-top: 10px; color: var(--ink-60); font-size: 18px; }
.project-right { display: flex; flex-direction: column; gap: 14px; }
.project-blurb { font-size: 15px; line-height: 1.55; color: var(--ink-60); max-width: 46ch; }
.open-link {
  font-size: 13px;
  color: var(--ink);
  border-bottom: 1px solid var(--ink);
  align-self: flex-start;
  padding-bottom: 2px;
  cursor: pointer;
  display: inline-block;
}
.open-link:hover { opacity: 0.6; }

/* ── MORE WORK LIST ── */
.more-work {
  padding: 0 var(--gutter);
  margin-top: 80px;
}
.more-work-header {
  display: flex;
  justify-content: space-between;
  border-top: 1px solid var(--rule);
  padding: 14px 0 0;
  margin-bottom: 0;
}
.mini-project:first-of-type { border-top: none; }
.mini-project {
  display: grid;
  grid-template-columns: 200px 1fr 180px 72px 40px;
  gap: 0 32px;
  align-items: center;
  border-top: 1px solid var(--rule-soft);
  padding: 24px 0;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}
.mini-project:hover .mini-thumb { opacity: 0.85; }
.mini-project:hover .mini-arrow { transform: translate(4px, -4px); color: var(--ink); }
.mini-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.mini-title {
  font-family: var(--display);
  font-size: clamp(24px, 2.4vw, 40px);
  letter-spacing: -0.03em;
  line-height: 1.02;
  font-weight: 400;
  color: var(--ink);
}
.mini-sub {
  font-size: 14px;
  line-height: 1.4;
  color: var(--ink-60);
}
.mini-tags {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.mini-tags span {
  font-family: var(--body);
  font-size: 11px;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink-40);
  font-weight: 500;
}
.mini-year {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-40);
}
.mini-arrow {
  font-size: 20px;
  color: var(--ink-40);
  transition: transform 0.2s, color 0.2s;
  text-align: center;
}
.mini-thumb {
  aspect-ratio: 16 / 10;
  border-radius: 20px;
  overflow: hidden;
  transition: opacity 0.2s;
  position: relative;
}
.mini-thumb img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

/* ── ABOUT ── */
.about {
  padding: 80px var(--gutter);
}
.about-label {
  font-family: var(--body);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-60);
  font-weight: 500;
  display: block;
  margin-bottom: 32px;
}
.about-body {
  display: grid;
  grid-template-columns: 1fr 240px;
  gap: 32px;
  align-items: start;
}
.about-text {
  font-family: var(--display);
  font-size: 26px;
  line-height: 1.35;
  letter-spacing: -0.015em;
  color: var(--ink);
  font-weight: 400;
}
.about-right {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.about-photo {
  width: 100%;
  height: auto;
  border-radius: 12px;
  object-fit: cover;
  display: block;
}
.about-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 24px;
  align-items: start;
}
.about-row { margin-top: 4px; font-size: 14px; }

@media (max-width: 900px) {
  .about-body { grid-template-columns: 1fr; gap: 40px; }
  .about-right { flex-direction: row; align-items: flex-start; gap: 24px; }
  .about-photo { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; }
}
@media (max-width: 600px) {
  .about-right { flex-direction: column; }
  .about-photo { width: 64px; height: 64px; }
}

/* ── CONTACT ── */
.contact {
  padding: 80px var(--gutter) 40px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.contact-email {
  font-family: var(--display);
  font-size: clamp(32px, 4vw, 64px);
  letter-spacing: -0.03em;
  margin-top: 12px;
  display: block;
}
.contact-email:hover { opacity: 0.6; }
.contact-links { display: flex; gap: 28px; }
.contact-links a { font-size: 15px; color: var(--ink-60); }
.contact-links a:hover { color: var(--ink); }

/* ── FOOTER ── */
footer {
  padding: 40px var(--gutter) 60px;
  display: flex;
  justify-content: space-between;
}

/* ── FADE-IN ── */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in { animation: fade-up 0.6s ease both; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  :root { --gutter: 5%; }
  .hero-bottom { grid-template-columns: 1fr; gap: 40px; }
  .project-foot { grid-template-columns: 1fr; gap: 24px; }
  .contact { flex-direction: column; gap: 32px; align-items: flex-start; }
  .mini-project { grid-template-columns: 120px 1fr 100px 56px 40px; gap: 0 20px; }
}
@media (max-width: 600px) {
  :root { --gutter: 20px; --radius: 20px; }
  .works { gap: 56px; }
  .hero { padding: 40px var(--gutter) 56px; }
  .hero-tags { font-size: 16px; margin-top: 32px; }
  .mini-tags, .mini-year { display: none; }
  .mini-project { grid-template-columns: 80px 1fr 40px; gap: 0 16px; padding: 20px 0; }
  .mini-thumb { border-radius: 12px; }
}

  /* ── PLACEHOLDER THUMB ── */
  .placeholder-thumb {
    background: var(--paper-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-40);
    letter-spacing: 0.02em;
  }

  </style>
</head>
<body>

<Nav />

<!-- HERO -->
