    <div class="project-meta">
      <div class="project-meta-left">
        <span class="mono">01</span>
        <span class="mono">Bagel.AI</span>
      </div>
      <span class="mono">2025</span>
    </div>
    <div class="project-media">
      <a href="/bagel" style="display: block;">
        <img class="project-thumb" src="/images/bagel-thumbnail@2x.png" alt="Bagel.AI - DiscoveryOS" style="box-shadow: 0 0 0 1px rgba(0,0,0,0.08);">
      </a>
    </div>
    <div class="project-foot">
      <div>
        <h2 class="project-title">Bagel.AI</h2>
        <div class="project-sub">Discovery 2.0</div>
