    <div class="project-foot">
      <div>
        <h2 class="project-title">HoneyBook AI</h2>
        <div class="project-sub">AI assisted Lead management</div>
      </div>
      <div class="project-right">
        <span class="meta" style="display:block">AI · SaaS · Fintech · B2B · Mobile</span>
        <p class="project-blurb">End-to-end AI feature for independent creatives. Human-in-the-loop from research to ship.</p>
        <a class="open-link" href="/honeybook">Open case study ↗</a>
      </div>
    </div>
  </article>

</section>

<!-- MORE WORK -->
<section class="more-work">
  <div class="more-work-header">
    <span class="meta">More work</span>
    <span class="meta">2017 - 2021</span>
  </div>

  <!-- Melio -->
  <a href="/melio" class="mini-project fade-in" data-tags="saas fintech b2b mobile desktop">
    <div class="mini-thumb">
      <img src="/images/Melio-thumbnail.png" alt="Melio - Payments &amp; Onboarding">
    </div>
    <div class="mini-body">
      <h3 class="mini-title">Melio</h3>
      <div class="mini-sub">B2B payment solution</div>
    </div>
    <div class="mini-tags">
      <span>Webapp</span>
      <span>Mobile web</span>
    </div>
    <span class="mini-year">2018</span>
    <span class="mini-arrow">→</span>
  </a>

  <!-- Deco -->
  <a href="/deco" class="mini-project fade-in" data-tags="saas fintech b2c desktop">
    <div class="mini-thumb">
      <img src="/images/Deco-thumnail.png" alt="Deco. - Visual Language &amp; Product Design">
    </div>
    <div class="mini-body">
      <h3 class="mini-title">Deco.</h3>
      <div class="mini-sub">Visual identity &amp; B2C User portal</div>
    </div>
    <div class="mini-tags">
      <span>Art direction</span>
      <span>User flow</span>
    </div>
    <span class="mini-year">2019</span>
    <span class="mini-arrow">→</span>
  </a>

