---
import Nav from '../components/Nav.astro';
---

<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Deco. — Dana Kreisberg</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap');

/* ─── TOKENS ─── */
:root {
  --paper:     #ffffff;
  --paper-2:   #f2f2f2;
  --ink:       oklch(14% 0.01 240);
  --ink-60:    oklch(14% 0.01 240 / 0.62);
  --ink-40:    oklch(14% 0.01 240 / 0.42);
  --rule:      oklch(14% 0.01 240 / 0.14);
  --rule-soft: oklch(14% 0.01 240 / 0.08);
  --display:   "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --body:      "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --mono:      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --gutter:    8%;
}

/* ─── RESET ─── */
*, *::before, *::after { box-sizing: border-box; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
p { margin: 0; }

body {
  font-family: var(--body);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ─── UTILITIES ─── */
.meta {
  font-family: var(--body);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-60);
  font-weight: 500;
  display: inline-block;
}
.mono {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.02em;
  color: var(--ink-40);
}

/* ════════════════════════════
   TITLE
════════════════════════════ */
.title-section { padding: 64px var(--gutter) 56px; }
.title-meta { display: flex; justify-content: space-between; margin-bottom: 40px; }
.cs-h1 {
  font-family: var(--display);
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.95;
  letter-spacing: -0.04em;
  margin: 0;
  font-weight: 400;
  max-width: 14ch;
}
.cs-h1 em { font-style: italic; font-weight: 100; }
.lede { margin-top: 40px; font-size: 19px; line-height: 1.5; color: var(--ink-60); max-width: 62ch; }
.meta-row {
  margin-top: 64px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  border-top: 1px solid var(--rule);
  padding-top: 24px;
}
.meta-val { margin-top: 8px; font-size: 15px; }

/* ════════════════════════════
   SECTIONS
════════════════════════════ */
.section { padding: 80px var(--gutter); background: #ffffff; border-top: 1px solid var(--rule); }
.section-alt {
  padding: 100px var(--gutter);
  background: #ffffff;
  border-top: 1px solid var(--rule);
}
.section-head {
  position: sticky;
  top: 0;
  z-index: 10;
  background: inherit;
  padding: 16px var(--gutter);
  margin-bottom: 40px;
  margin-left: calc(-1 * var(--gutter));
  margin-right: calc(-1 * var(--gutter));
  border-bottom: 1px solid var(--rule-soft);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

/* ════════════════════════════
   HEADINGS
════════════════════════════ */
.cs-h2-wide {
  font-family: var(--display);
  font-size: clamp(40px, 4.4vw, 72px);
  line-height: 1.02;
  letter-spacing: -0.032em;
  margin: 0 0 40px;
  font-weight: 400;
  max-width: 24ch;
}
.cs-h2-wide em { font-style: italic; font-weight: 100; }
.feature-h {
  font-family: var(--display);
  font-size: clamp(22px, 2.5vw, 32px);
  letter-spacing: -0.02em;
  line-height: 1.15;
  font-weight: 400;
  margin: 0 0 20px;
  max-width: 50ch;
}
.feature-num {
  font-size: 12px;
  color: var(--ink-40);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.body-text { font-size: 16px; line-height: 1.6; color: var(--ink-60); max-width: 56ch; }
.body-text strong { color: var(--ink); font-weight: 500; }

/* ════════════════════════════
   LAYOUT
════════════════════════════ */
.two-col   { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }
.feat-split { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; align-items: start; }
.screens-3up { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.feature-block { margin-bottom: 72px; }
.feature-block:last-child { margin-bottom: 0; }

/* ════════════════════════════
   PHOTO GALLERY (square crop)
════════════════════════════ */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-top: 48px;
}
.photo-grid-item {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 8px;
}
.photo-grid-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ════════════════════════════
   CALLOUT
════════════════════════════ */
.callout {
  background: rgba(0,0,0,0.04);
  border-left: 3px solid rgba(0,0,0,0.15);
  border-radius: 0 8px 8px 0;
  padding: 20px 24px;
  margin-top: 24px;
}
.callout p { font-size: 14px; line-height: 1.6; color: var(--ink-60); }
.callout-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
  margin-bottom: 8px;
  display: block;
}
.callout strong {
  font-family: var(--display);
  font-size: 18px;
  font-style: italic;
  font-weight: 400;
  letter-spacing: -0.02em;
  color: var(--ink);
  display: block;
  margin-bottom: 4px;
}
.flow-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
  margin-bottom: 16px;
  display: block;
}

/* ════════════════════════════
   IMAGE FRAMES
════════════════════════════ */
.img-frame { display: flex; flex-direction: column; gap: 10px; }
.img-frame > img { width: 100%; display: block; border-radius: 12px; border: 1px solid var(--rule); }
.img-bare { display: block; width: 100%; }
.img-bare img { width: 100%; display: block; border-radius: 12px; }
.img-caption { font-size: 13px; color: var(--ink-40); letter-spacing: 0.01em; }
.screen-img { overflow: visible; display: flex; flex-direction: column; }
.screen-img img { width: 100%; display: block; border-radius: 30px; max-height: 800px; object-fit: contain; }

/* ════════════════════════════
   RESPONSIVE
════════════════════════════ */
@media (max-width: 900px) {
  :root { --gutter: 5%; }
  .two-col, .feat-split { grid-template-columns: 1fr; gap: 32px; }
  .meta-row { grid-template-columns: 1fr 1fr; }
  .screens-3up { grid-template-columns: 1fr 1fr; }
  .photo-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  :root { --gutter: 20px; }
  .title-meta { flex-direction: column; gap: 8px; }
  .meta-row { grid-template-columns: 1fr; }
  .screens-3up { grid-template-columns: 1fr; }
  .photo-grid { grid-template-columns: repeat(2, 1fr); }
}

/* ── NEXT PROJECT ── */
.next-project-bar {
  display: block;
  padding: 48px var(--gutter) 80px;
  border-top: 1px solid var(--rule);
  background: var(--paper);
  text-decoration: none;
  color: var(--ink);
  transition: opacity 0.2s;
}
.next-project-bar:hover { opacity: 0.6; }
.next-project-label {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
  display: block;
  margin-bottom: 16px;
}
.next-project-title {
  font-family: var(--display);
  font-size: clamp(32px, 4vw, 64px);
  letter-spacing: -0.03em;
  font-weight: 400;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 16px;
}
  </style>
</head>
<body>
<Nav />

<!-- ── § 01 — TITLE ── -->
<section class="title-section">
  <div class="title-meta">
    <span class="meta">Visual Language &amp; Product Design · 04</span>
    <span class="meta">Deco Payments · 2018–2019</span>
  </div>
  <h1 class="cs-h1">
    Visual language<br>
    &amp; product design<br>
    for <em>Deco Payments.</em>
  </h1>
  <p class="lede">
    Deco is a buy-now, pay-later solution for young fashion shoppers. I led design end-to-end — from brand identity and marketing art direction to the user app and its payment flows.
  </p>
  <div class="meta-row">
    <div>
      <span class="meta">Role</span>
      <div class="meta-val">Lead Designer · Full product ownership</div>
    </div>
    <div>
      <span class="meta">Deliverables</span>
      <div class="meta-val">Brand system · Campaign · User app</div>
    </div>
    <div>
      <span class="meta">Timeline</span>
      <div class="meta-val">2018–2019</div>
    </div>
  </div>

  <div class="img-bare" style="margin-top: 56px;">
    <img src="/images/Deco-01.png" alt="Deco Payments hero" />
  </div>
</section>


<!-- ── § 02 — ART DIRECTION ── -->
<section class="section">
  <div class="section-head">
    <span class="meta">§ 02 — Art direction</span>
  </div>

  <div class="feat-split" style="margin-bottom: 0;">
    <div>
      <h2 class="cs-h2-wide">
        Stop-motion-inspired<br>
        <em>campaign photography.</em>
      </h2>
      <p class="body-text" style="font-size: 17px;">
        Using semi-stills and subtle movement, we built scenes that demonstrate how a single click leads to instant ownership. The youthful colour palette and styling reflect a confident, fashion-driven audience.
      </p>
    </div>
    <div class="img-bare">
      <img src="/images/Deco-02.gif" alt="Campaign photography" />
    </div>
  </div>

  <div class="photo-grid">
    <div class="photo-grid-item">
      <img src="/images/Deco-03.gif" alt="Campaign photo" />
    </div>
    <div class="photo-grid-item">
      <img src="/images/Deco-04.gif" alt="Campaign photo" />
    </div>
    <div class="photo-grid-item">
      <img src="/images/Deco-05.gif" alt="Campaign photo" />
    </div>
    <div class="photo-grid-item">
      <img src="/images/Deco-06.gif" alt="Campaign photo" />
    </div>
  </div>
</section>


<!-- ── § 03 — BRAND SYSTEM ── -->
<section class="section">
  <div class="section-head">
    <span class="meta">§ 03 — Brand system</span>
  </div>

  <h2 class="cs-h2-wide">
    Identity built on<br>
    <em>motion and geometry.</em>
  </h2>

  <div class="feature-block">
    <div class="feature-num">Motion iconography</div>
    <div class="feat-split">
      <div>
        <p class="body-text">Each brand value — ease, flexibility, speed — is expressed as a minimal animated icon. Arc and dot forms, designed to run on the marketing site.</p>
      </div>
      <div class="img-bare">
        <img src="/images/Deco-07.gif" alt="Motion iconography" />
      </div>
    </div>
  </div>

  <div class="feature-block">
    <div class="feature-num">Logo &amp; styleguide</div>
    <div class="img-bare" style="margin-top: 16px;">
      <img src="/images/Deco-08.png" alt="Logo and styleguide" />
    </div>
  </div>
</section>


<!-- ── § 04 — DESIGN PROCESS ── -->
<section class="section">
  <div class="section-head">
    <span class="meta">§ 04 — Design process</span>
  </div>

  <h2 class="cs-h2-wide" style="max-width: 100%;">
    The app that works best when<br>
    <em>you never need it.</em>
  </h2>

  <p class="body-text" style="max-width: 56ch; margin-bottom: 40px;">
    By mapping all entry points and user states, I identified a key constraint: the "happy flow" never requires the app at all. Users only arrive when something has gone wrong.
  </p>

  <div class="img-bare" style="margin-bottom: 32px;">
    <img src="/images/Deco-09.png" alt="Design process flow map" />
  </div>

  <div class="callout" style="max-width: 64ch;">
    <span class="callout-label">Key insight</span>
    <p>Optimise for the failure state, not the ideal one. The main view became a single-order focus — nothing else.</p>
  </div>
</section>


<!-- ── § 05 — USER FLOW & APP ── -->
<section class="section-alt">
  <div class="section-head">
    <span class="meta">§ 05 — User flow &amp; app</span>
  </div>

  <h2 class="cs-h2-wide">
    Designed for one visit,<br>
    <em>one decision.</em>
  </h2>
  <p class="body-text" style="font-size: 17px; max-width: 64ch; margin-bottom: 56px;">
    Users arrive under time pressure — often from an email link, with a single goal: pay for their order. The app optimises for someone who will likely never return.
  </p>

  <div class="feature-block">
    <span class="flow-label">User flow</span>
    <div class="img-bare">
      <img src="/images/Deco-10.gif" alt="User flow" />
    </div>
  </div>

  <div class="feature-block">
    <span class="flow-label">Payment flow</span>
    <div class="screens-3up">
      <div class="screen-img">
        <img src="/images/Deco-11.gif" alt="Payment flow screen 1" />
      </div>
      <div class="screen-img">
        <img src="/images/Deco-12.gif" alt="Payment flow screen 2" />
      </div>
      <div class="screen-img">
        <img src="/images/Deco-13.gif" alt="Payment flow screen 3" />
      </div>
    </div>
  </div>
</section>

<a class="next-project-bar" href="/riskified">
  <span class="next-project-label">Next project</span>
  <div class="next-project-title">Riskified →</div>
</a>

</body>
</html>
