    </div>
    <div class="stat" style="border-right: 0;">
      <div class="stat-n">5,360</div>
      <div class="stat-l">Total attendees tracked</div>
    </div>
  </div>

  <div class="research-grid-bizzabo">
    <div style="display: flex; align-items: flex-start;">
      <div class="desktop-frame-wrap research-screen-wrap">
        <img src="/images/Bizzabo-01.png" alt="">
      </div>
    </div>
    <div style="display: flex; align-items: flex-start;">
      <div class="img-frame research-screen-wrap">
        <img src="/images/Bizzabo-02.png" alt="">
      </div>
    </div>
  </div>
</section>


<!-- ── § 04 — RESEARCH FINDINGS ── -->
<section class="section-dark" style="padding-top: 24px; padding-bottom: 24px;">
  <div class="section-head">
    <span class="meta">§ 04 — Research findings</span>
  </div>
  <h2 class="cs-h2-wide">
    Key observations from<br>
    <em>usability testing.</em>
  </h2>

  <div class="finding-grid">
