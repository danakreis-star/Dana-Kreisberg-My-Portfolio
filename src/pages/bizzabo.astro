---
import Nav from '../components/Nav.astro';
---

<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Bizzabo — Dana Kreisberg</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style is:global>

/* ─── TOKENS ─── */
:root {
  --paper:     oklch(98% 0.003 240);
  --paper-2:   #DDDAD4;
  --ink:       oklch(14% 0.01 240);
  --ink-60:    oklch(14% 0.01 240 / 0.62);
  --ink-40:    oklch(14% 0.01 240 / 0.42);
  --rule:      oklch(14% 0.01 240 / 0.14);
  --rule-soft: oklch(14% 0.01 240 / 0.08);
  --accent:    oklch(58% 0.14 250);
  --display:   "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --body:      "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --mono:      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --gutter:    8%;
}

/* ─── RESET ─── */
*, *::before, *::after { box-sizing: border-box; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
p { margin: 0; }

body {
  font-family: var(--body);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-feature-settings: "ss01", "cv11";
}

/* ─── UTILITIES ─── */
.meta {
  font-family: var(--body);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-60);
  font-weight: 500;
  display: inline-block;
}
.mono {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.02em;
  color: var(--ink-40);
}

/* ════════════════════════════
   TITLE
════════════════════════════ */
.title-section { padding: 64px var(--gutter) 56px; }
.title-meta { display: flex; justify-content: space-between; margin-bottom: 40px; }
.cs-h1 {
  font-family: var(--display);
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.95;
  letter-spacing: -0.04em;
  margin: 0;
  font-weight: 400;
  max-width: 14ch;
}
.cs-h1 em { font-style: italic; font-weight: 100; }
.lede { margin-top: 40px; font-size: 19px; line-height: 1.5; color: var(--ink-60); max-width: 62ch; }
.meta-row {
  margin-top: 64px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  border-top: 1px solid var(--rule);
  padding-top: 24px;
}
.meta-val { margin-top: 8px; font-size: 15px; }

/* ════════════════════════════
   SECTIONS
════════════════════════════ */
.section { padding: 80px var(--gutter); }
.section-alt {
  padding: 100px var(--gutter);
  background: var(--paper-2);
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}
.section-dark {
  padding: 100px var(--gutter);
  background: #404040;
  border-top: 1px solid rgba(255,255,255,0.08);
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.section-dark .meta,
.section-dark .mono,
.section-dark .cs-h2-wide,
.section-dark .body-text,
.section-dark .stat-l,
.section-dark .stat-n,
.section-dark .stat-d { color: rgba(255,255,255,0.85); }
.section-dark .stat-n { color: #fff; }
.section-dark .stat-d { color: rgba(255,255,255,0.45); }
.section-dark .stat-row { border-top-color: rgba(255,255,255,0.15); }
.section-dark .section-head { border-bottom-color: rgba(255,255,255,0.1); background: #404040; }
.section-dark .finding { border-bottom-color: rgba(255,255,255,0.1); border-right-color: rgba(255,255,255,0.08); }
.section-dark .finding-grid { border-top-color: rgba(255,255,255,0.15); }
.section-dark .finding-t { color: #fff; }
.section-dark .finding-b { color: rgba(255,255,255,0.6); }
.section-dark .finding-k { color: rgba(255,255,255,0.35); }

/* Phase-specific section backgrounds */
.phase-before { padding: 80px var(--gutter); background: #F5F5F5; }
.phase-during {
  padding: 80px var(--gutter);
  background: #E8E8E8;
  border-top: 1px solid rgba(0,0,0,0.06);
  border-bottom: 1px solid rgba(0,0,0,0.06);
}
.phase-during .meta,
.phase-during .body-text,
.phase-during .feature-h,
.phase-during .feature-num,
.phase-during .fig-cap,
.phase-during .phase-subtitle { color: var(--ink-60); }
.phase-during .cs-h2-wide { color: var(--ink); }
.phase-during .phase-tag-during { background: rgba(72,183,163,0.12); border-color: rgba(72,183,163,0.3); color: rgba(40,150,135,1); }
.phase-during .insight-box-during { background: rgba(72,183,163,0.07); border-left-color: rgba(72,183,163,0.3); }
.phase-during .insight-box p { color: var(--ink-60); }
.phase-during .insight-box strong { color: var(--ink); }
.phase-during .phase-section { border-top-color: var(--rule); }
.phase-after { padding: 80px var(--gutter); background: #F5F5F5; }

.section-head {
  position: sticky;
  top: 0;
  z-index: 10;
  background: inherit;
  padding-top: 16px;
  padding-bottom: 16px;
  margin-bottom: 40px;
  margin-left: calc(-1 * var(--gutter));
  margin-right: calc(-1 * var(--gutter));
  padding-left: var(--gutter);
  padding-right: var(--gutter);
  border-bottom: 1px solid var(--rule-soft);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.ship-stamp { font-family: var(--mono); font-size: 12px; color: var(--ink-40); letter-spacing: 0.04em; }

/* ════════════════════════════
   HEADINGS
════════════════════════════ */
.cs-h2 {
  font-family: var(--display);
  font-size: clamp(36px, 3.8vw, 60px);
  line-height: 1.02 !important;
  letter-spacing: -0.03em;
  margin: 0;
  font-weight: 400;
  max-width: 16ch;
}
.cs-h2-wide {
  font-family: var(--display);
  font-size: clamp(40px, 4.4vw, 72px);
  line-height: 1.02 !important;
  letter-spacing: -0.032em;
  margin: 0 0 40px;
  font-weight: 400;
  max-width: 24ch;
}
.cs-h2-wide em { font-style: italic; font-weight: 300; }
.body-text { font-size: 16px; line-height: 1.6; color: var(--ink-60); max-width: 56ch; }
.body-text strong { color: var(--ink); font-weight: 500; }

/* ════════════════════════════
   TWO-COL
════════════════════════════ */
.two-col { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }

/* ════════════════════════════
   STATS ROW
════════════════════════════ */
.stat-row { margin-top: 56px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--rule); }
.stat { padding: 40px 32px 40px 0; border-right: 0; }
.stat:last-child { border-right: 0; }
.stat-n { font-family: var(--display); font-size: clamp(64px, 8vw, 128px); letter-spacing: -0.04em; line-height: 1; font-weight: 400; padding-top: 24px; }
.stat-d { font-family: var(--display); font-size: clamp(28px, 3vw, 48px); color: var(--ink-40); margin-left: 4px; }
.stat-l { margin-top: 18px; font-size: 15px; line-height: 1.5; color: var(--ink-60); max-width: 28ch; font-style: normal !important; font-family: var(--body); }

/* ════════════════════════════
   FUNNEL CHART
════════════════════════════ */
.funnel-block { margin-top: 64px; border-top: 1px solid var(--rule); padding-top: 24px; }
.funnel-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; }
.funnel { display: flex; flex-direction: column; gap: 14px; margin-bottom: 56px; }
.funnel-row { display: grid; grid-template-columns: 220px 1fr 160px; align-items: center; gap: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--rule-soft); }
.funnel-label { font-family: var(--display); font-size: 20px; letter-spacing: -0.015em; }
.funnel-bar-wrap { height: 22px; background: oklch(90% 0.004 240); border: 1px solid var(--rule-soft); position: relative; }
.funnel-bar { height: 100%; background: var(--ink); }
.funnel-figs { display: flex; justify-content: flex-end; align-items: baseline; gap: 18px; font-family: var(--mono); }
.funnel-pct { font-size: 16px; color: var(--ink); }
.funnel-count { font-size: 13px; color: var(--ink-40); }

/* ════════════════════════════
   FINDINGS GRID
════════════════════════════ */
.finding-grid { margin-top: 24px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border-top: 1px solid var(--rule); }
.finding { padding: 28px 32px 32px 0; border-bottom: 1px solid var(--rule); border-right: 1px solid var(--rule-soft); }
.finding:nth-child(even) { border-right: 0; padding-right: 0; padding-left: 32px; }
.finding-k { display: flex; justify-content: space-between; align-items: center; color: var(--ink-40); }
.finding-score { font-family: var(--mono); font-size: 18px; color: var(--accent); letter-spacing: -0.01em; }
.finding-t { margin-top: 12px; font-family: var(--display); font-size: 28px; letter-spacing: -0.022em; line-height: 1.15; }
.finding-b { margin-top: 12px; font-size: 15px; line-height: 1.55; color: var(--ink-60); max-width: 50ch; }

/* ════════════════════════════
   PHASE SECTIONS
════════════════════════════ */
.phase-section { margin-top: 72px; padding-top: 32px; border-top: 1px solid var(--rule); }
.phase-row { display: flex; align-items: baseline; gap: 20px; margin-bottom: 48px; }
.phase-tag { font-family: var(--body); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; padding: 6px 14px; border-radius: 20px; white-space: nowrap; }
.phase-tag-before { background: rgba(139,115,85,0.12); border: 1px solid rgba(139,115,85,0.3); color: rgba(139,115,85,1); }
.phase-tag-during { background: rgba(72,183,163,0.12); border: 1px solid rgba(72,183,163,0.3); color: rgba(40,150,135,1); }
.phase-tag-after { background: rgba(168,130,200,0.12); border: 1px solid rgba(168,130,200,0.3); color: rgba(130,90,170,1); }
.phase-subtitle { font-size: 14px; font-style: italic; color: var(--ink-40); }

/* ════════════════════════════
   FEATURE BLOCKS
════════════════════════════ */
.feature-block { margin-bottom: 80px; }
.feature-num { font-size: 12px; color: var(--ink-40); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 12px; }
.feature-h { font-family: var(--display); font-size: clamp(22px, 2.5vw, 32px); letter-spacing: -0.02em; line-height: 1.15 !important; font-weight: 400; margin: 0 0 20px; max-width: 50ch; }
.insight-box { padding: 16px 20px; border-radius: 0 8px 8px 0; margin-top: 20px; margin-bottom: 24px; }
.insight-box-before { background: rgba(139,115,85,0.07); border-left: 3px solid rgba(139,115,85,0.35); }
.insight-box-during { background: rgba(72,183,163,0.07); border-left: 3px solid rgba(72,183,163,0.35); }
.insight-box-after { background: rgba(168,130,200,0.07); border-left: 3px solid rgba(168,130,200,0.35); }
.insight-box p { font-size: 14px; line-height: 1.6; color: var(--ink-60); margin: 0; font-style: normal !important; font-family: var(--body) !important; }
.insight-box strong { color: var(--ink); }
.fig-cap { font-size: 13px; color: var(--ink-40); margin-top: 12px; letter-spacing: 0.01em; }

/* ════════════════════════════
   LAYOUT HELPERS
════════════════════════════ */
.feat-split { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; align-items: start; }
.screens-2up { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
.screens-3up { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 24px; align-items: flex-start; }

/* Mobile screens — transparent bg, caption outside */
.screen-img {
  border-radius: 0;
  overflow: visible;
  background: transparent;
  display: flex;
  flex-direction: column;
}
.screen-img img,
.screen-img video {
  max-height: 800px;
  width: auto;
  max-width: 100%;
  object-fit: contain;
  display: block;
  border-radius: 30px;
}
.screen-img .gallery_image_caption {
  padding: 12px 4px 0;
  margin: 0;
  font-size: 13px;
  color: var(--ink-40);
  letter-spacing: 0.01em;
  background: none;
  text-align: center;
}

/* Desktop frames */
.img-frame { border-radius: 12px; overflow: visible; border: none; display: flex; flex-direction: column; }
.img-frame img,
.img-frame video { width: 100%; display: block; vertical-align: bottom; border-radius: 12px; border: none; }
.img-frame .gallery_image_caption { padding: 10px 0 0; margin: 0; font-size: 13px; color: var(--ink-40); letter-spacing: 0.01em; background: none; }
.screen-img,
.screen-img img,
.screen-img video { border: none; }

.desktop-plus-mobile { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; align-items: start; margin-top: 24px; }
.research-grid { display: grid; grid-template-columns: 1.33fr 0.57fr; gap: 24px; margin-top: 40px; align-items: start; }

/* ════════════════════════════
   CLOSING (dark)
════════════════════════════ */
.closing { background: #0b0b0d; color: #e6e6e7; padding: 140px var(--gutter); }
.closing-kicker { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
.closing-quote {
  margin: 32px 0 0;
  font-family: var(--display);
  font-size: clamp(32px, 4.4vw, 72px);
  line-height: 1.1;
  letter-spacing: -0.03em;
  font-weight: 300;
  max-width: 22ch;
}
.closing-quote em { font-style: italic; }

/* ════════════════════════════
   DESKTOP FRAME WRAP
════════════════════════════ */
.desktop-frame-wrap {
  border-radius: 35px;
  overflow: hidden;
  border: 1px solid var(--rule);
  display: block;
  width: 100%;
}
.desktop-frame-wrap img,
.desktop-frame-wrap video {
  display: block;
  width: 100%;
  border-radius: 0;
  border: none;
}

/* ════════════════════════════
   MOBILE VIDEO
════════════════════════════ */
.mobile-video {
  border-radius: 30px;
  overflow: hidden;
  display: block;
}

/* ════════════════════════════
   RESEARCH GRID (§ 03)
════════════════════════════ */
.research-grid-bizzabo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  margin-top: 40px;
  align-items: start;
}
.research-screen-wrap {
  display: inline-block !important;
  width: auto !important;
  border-radius: 30px;
  overflow: hidden;
  border: 1px solid var(--rule);
}
.research-grid-bizzabo .img-frame,
.research-grid-bizzabo .desktop-frame-wrap {
  overflow: hidden;
  border-radius: 30px;
}
.research-grid-bizzabo .img-frame img,
.research-grid-bizzabo .desktop-frame-wrap img {
  width: auto !important;
  max-width: 100%;
  max-height: 700px;
  height: auto;
  display: block;
  border-radius: 30px;
  object-fit: contain;
}

/* ════════════════════════════
   MEDIA BORDER RADIUS
════════════════════════════ */
@media (min-width: 601px) {
  .img-frame img,
  .img-frame video { border-radius: 12px; }
  .screen-img img,
  .screen-img video { border-radius: 30px; }
}

/* ════════════════════════════
   RESPONSIVE
════════════════════════════ */
@media (max-width: 900px) {
  :root { --gutter: 5%; }
  .two-col, .feat-split, .desktop-plus-mobile, .research-grid { grid-template-columns: 1fr; gap: 32px; }
  .meta-row { grid-template-columns: 1fr 1fr; }
  .stat-row { grid-template-columns: 1fr 1fr; }
  .finding-grid { grid-template-columns: 1fr; }
  .finding { border-right: 0; padding-right: 0; padding-left: 0; }
  .finding:nth-child(even) { padding-left: 0; }
  .funnel-row { grid-template-columns: 1fr; gap: 8px; }
}
@media (max-width: 600px) {
  :root { --gutter: 20px; }
  .title-meta { flex-direction: column; gap: 8px; }
  .meta-row { grid-template-columns: 1fr; }
  .stat-row { grid-template-columns: 1fr; }
  .screens-2up,
  .screens-3up,
  .feat-split,
  .desktop-plus-mobile,
  .research-grid-bizzabo { grid-template-columns: 1fr; gap: 24px; }
}

/* ── NEXT PROJECT ── */
.next-project-bar {
  display: block;
  padding: 48px var(--gutter) 80px;
  border-top: 1px solid var(--rule);
  background: var(--paper);
  text-decoration: none;
  color: var(--ink);
  transition: opacity 0.2s;
}
.next-project-bar:hover { opacity: 0.6; }
.next-project-label {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
  display: block;
  margin-bottom: 16px;
}
.next-project-title {
  font-family: var(--display);
  font-size: clamp(32px, 4vw, 64px);
  letter-spacing: -0.03em;
  font-weight: 400;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 16px;
}

  </style>
</head>
<body>

<Nav />

<!-- ── § 01 — TITLE ── -->
<section class="title-section">
  <div class="title-meta">
    <span class="meta">Case Study · 02</span>
    <span class="meta">Bizzabo · 2021–2023 · Product Design</span>
  </div>
  <h1 class="cs-h1">
    Before, during, after:<br>
    Redesigning how people<br>
    <em>connect</em> at events.
  </h1>
  <p class="lede">
    Bizzabo was built for in-person conferences. When COVID hit, the team pivoted fast — launching an entirely new virtual venue product in weeks. I led the design of the community space, Messages and Meetings — and then drove the research to understand whether they actually worked.
  </p>
  <div class="meta-row">
    <div>
      <span class="meta">Role</span>
      <div class="meta-val">Senior Product Designer → Mobile Lead</div>
    </div>
    <div>
      <span class="meta">Platform</span>
      <div class="meta-val">Web + Mobile (hybrid)</div>
    </div>
    <div>
      <span class="meta">Research</span>
      <div class="meta-val">3 events · 5,360 attendees observed</div>
    </div>
  </div>
</section>


<!-- ── § 02 — STARTING POINT ── -->
<section class="section">
  <div class="section-head">
    <span class="meta">§ 02 — Starting point</span>
  </div>

  <div class="two-col">
    <h2 class="cs-h2">A desktop-first MVP built for a world that hadn't gone hybrid yet</h2>
    <p class="body-text">
      Bizzabo launched its networking feature for in-person events. By 2021, the world had shifted to hybrid — attendees split across physical venues and virtual rooms, on different devices, in different time zones. The product hadn't moved with them.
      <br><br>
      The feature existed. It just wasn't working. Attendees couldn't find it, didn't trust it, and weren't using it to connect.
    </p>
  </div>

  <div class="desktop-frame-wrap" style="margin-top: 48px;">
    <img src="/images/Bizzabo-00.gif" alt="Community page">
  </div>

  <div class="stat-row">
    <div class="stat">
      <div class="stat-n">100<span class="stat-d">%</span></div>
      <div class="stat-l">Registered attendees</div>
    </div>
    <div class="stat">
      <div class="stat-n">~60<span class="stat-d">%</span></div>
      <div class="stat-l">Logged into the platform</div>
    </div>
    <div class="stat" style="border-right: 0;">
      <div class="stat-n">~8<span class="stat-d">%</span></div>
      <div class="stat-l">Sent at least one message</div>
    </div>
  </div>

  <div class="funnel-block">
    <div class="funnel-head">
      <span class="meta">Chart — Engagement funnel</span>
      <span class="mono">5,360 attendees across 3 events</span>
    </div>
    <div class="funnel">
      <div class="funnel-row">
        <div class="funnel-label">Entered venue</div>
        <div class="funnel-bar-wrap"><div class="funnel-bar" style="width:100%"></div></div>
        <div class="funnel-figs"><span class="funnel-pct">100%</span><span class="funnel-count">5,360</span></div>
      </div>
      <div class="funnel-row">
        <div class="funnel-label">Visited networking section</div>
        <div class="funnel-bar-wrap"><div class="funnel-bar" style="width:28%"></div></div>
        <div class="funnel-figs"><span class="funnel-pct">28%</span><span class="funnel-count">1,501</span></div>
      </div>
      <div class="funnel-row">
        <div class="funnel-label">Sent a message</div>
        <div class="funnel-bar-wrap"><div class="funnel-bar" style="width:8%"></div></div>
        <div class="funnel-figs"><span class="funnel-pct">8%</span><span class="funnel-count">429</span></div>
      </div>
    </div>
  </div>

  <p class="body-text">
    <strong>Key insight:</strong> The funnel was leaking at the top, not the bottom. Attendees who found messaging wanted to use it. Most never found it.
  </p>
</section>


<!-- ── § 03 — RESEARCH & METHOD ── -->
<section class="section">
  <div class="section-head">
    <span class="meta">§ 03 — Research &amp; method</span>
  </div>
  <h2 class="cs-h2-wide">
    Four research methods.<br>
    <em>One consistent finding.</em>
  </h2>
  <p class="body-text" style="font-size: 17px; max-width: 64ch; margin-bottom: 56px;">
    Research ran across live events, post-conference interviews, quantitative surveys, and remote usability testing. The methods overlapped intentionally — each confirmed what the last had surfaced.
  </p>

  <div class="stat-row">
    <div class="stat">
      <div class="stat-n">4</div>
      <div class="stat-l">Research methods employed</div>
