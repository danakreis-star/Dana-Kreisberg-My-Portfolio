---
import Nav from '../components/Nav.astro';
---

<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Bagel.AI — Dana Kreisberg</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;1,100;1,300;1,400&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style is:global>

/* ─── TOKENS ─── */
:root {
  --paper:     #ffffff;
  --paper-2:   #f2f2f2;
  --ink:       oklch(14% 0.01 240);
  --ink-60:    oklch(14% 0.01 240 / 0.62);
  --ink-40:    oklch(14% 0.01 240 / 0.42);
  --rule:      oklch(14% 0.01 240 / 0.14);
  --rule-soft: oklch(14% 0.01 240 / 0.08);
  --display:   "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --body:      "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --mono:      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --gutter:    8%;

  /* ── Bagel brand ── */
  --bagel-purple:        #5C5CEB;
  --bagel-orange:        #FF8700;
  --bagel-tint:          #F8F8FB;
  --bagel-purple-soft:   rgba(92,92,235,0.08);
  --bagel-purple-border: rgba(92,92,235,0.32);
  --bagel-orange-soft:   rgba(255,135,0,0.10);
}

/* ─── RESET ─── */
*, *::before, *::after { box-sizing: border-box; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
p { margin: 0; }

body {
  font-family: var(--body);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-feature-settings: "ss01", "cv11";
}

/* ─── UTILITIES ─── */
.meta {
  font-family: var(--body);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-60);
  font-weight: 500;
  display: inline-block;
}
.mono {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.02em;
  color: var(--ink-40);
}

/* ════════════════════════════
   TITLE
════════════════════════════ */
.title-section { padding: 64px var(--gutter) 56px; }
.title-meta { display: flex; justify-content: space-between; margin-bottom: 40px; }
.cs-h1 {
  font-family: var(--display);
  font-size: clamp(48px, 7vw, 96px);
  line-height: 0.95;
  letter-spacing: -0.04em;
  margin: 0;
  font-weight: 400;
  max-width: 14ch;
}
.cs-h1 em { font-style: italic; font-weight: 100; color: var(--bagel-purple); }
.lede { margin-top: 40px; font-size: 19px; line-height: 1.5; color: var(--ink-60); max-width: 62ch; }
.meta-row {
  margin-top: 64px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  border-top: 1px solid var(--rule);
  padding-top: 24px;
}
.meta-val { margin-top: 8px; font-size: 15px; }

/* ════════════════════════════
   SECTIONS
════════════════════════════ */
.section { padding: 80px var(--gutter); }
.section-alt {
  padding: 100px var(--gutter);
  background: var(--paper-2);
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}

/* ════════════════════════════
   HEADINGS
════════════════════════════ */
.cs-h2 {
  font-family: var(--display);
  font-size: clamp(36px, 3.8vw, 60px);
  line-height: 1.02;
  letter-spacing: -0.03em;
  margin: 0;
  font-weight: 400;
  max-width: 16ch;
}
.cs-h2-wide {
  font-family: var(--display);
  font-size: clamp(40px, 4.4vw, 72px);
  line-height: 1.02;
  letter-spacing: -0.032em;
  margin: 0 0 40px;
  font-weight: 400;
  max-width: 24ch;
}
.cs-h2-wide em { font-style: italic; font-weight: 300; }
.body-text { font-size: 16px; line-height: 1.6; color: var(--ink-60); max-width: 56ch; }
.body-text + .body-text { margin-top: 16px; }
.body-text strong { color: var(--ink); font-weight: 500; }

/* ════════════════════════════
   TWO-COL
════════════════════════════ */
.two-col { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }

/* ════════════════════════════
   STATS ROW
════════════════════════════ */
.stat-row { margin-top: 56px; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--rule); }
.stat { padding: 40px 32px 40px 0; }
.stat-n { font-family: var(--display); font-size: clamp(64px, 8vw, 128px); letter-spacing: -0.04em; line-height: 1; font-weight: 400; padding-top: 24px; }
.stat-d { font-family: var(--display); font-size: clamp(28px, 3vw, 48px); color: var(--ink-40); margin-left: 4px; }
.stat-l { margin-top: 18px; font-size: 15px; line-height: 1.5; color: var(--ink-60); max-width: 28ch; font-family: var(--body); }

/* ════════════════════════════
   FEAT SPLIT
════════════════════════════ */
.feat-split { display: grid; grid-template-columns: 1fr 1.4fr; gap: 56px; align-items: start; }

/* ════════════════════════════
   IMAGE FRAMES
════════════════════════════ */
.img-frame { overflow: visible; border: none; display: flex; flex-direction: column; }
.img-frame img,
.img-frame video { width: 100%; display: block; vertical-align: bottom; border-radius: 12px; border: 1px solid var(--rule); }
.fig-cap { padding: 10px 0 0; margin: 0; font-size: 13px; color: var(--ink-40); letter-spacing: 0.01em; }

/* ════════════════════════════
   CLOSING (dark)
════════════════════════════ */
.closing { background: #0b0b0d; color: #e6e6e7; padding: 140px var(--gutter); }
.closing-kicker { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
.closing-quote {
  margin: 32px 0 0;
  font-family: var(--display);
  font-size: clamp(32px, 4.4vw, 72px);
  line-height: 1.1;
  letter-spacing: -0.03em;
  font-weight: 300;
  max-width: 22ch;
}
.closing-quote em { font-style: italic; }

/* ════════════════════════════
   BAGEL COMPONENTS
════════════════════════════ */

/* Purple insight callout */
.bagel-callout {
  background: var(--bagel-purple-soft);
  border-left: 3px solid var(--bagel-purple-border);
  border-radius: 0 8px 8px 0;
  padding: 18px 22px;
  margin-top: 28px;
  max-width: 680px;
}
.bagel-callout p {
  font-size: 0.95rem;
  line-height: 1.65;
  color: var(--ink);
  font-style: italic;
  margin-bottom: 6px;
}
.bagel-callout cite {
  font-family: var(--mono);
  font-size: 0.75rem;
  color: var(--ink-60);
  font-style: normal;
}

/* Orange principle callout */
.bagel-principle {
  background: var(--bagel-orange-soft);
  border-left: 3px solid rgba(255,135,0,0.45);
  border-radius: 0 6px 6px 0;
  padding: 12px 16px;
  font-size: 0.83rem;
  line-height: 1.55;
  color: var(--ink);
  font-style: italic;
  margin-top: 16px;
}

/* JTBD cards grid */
.jtbd-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 32px;
}
.jtbd-card {
  background: #ffffff;
  border: 1.5px solid var(--bagel-purple-border);
  border-radius: 10px;
  padding: 24px;
  box-shadow: 0 2px 12px rgba(92,92,235,0.06);
}
.jtbd-num {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--bagel-orange);
  text-transform: uppercase;
  display: block;
  margin-bottom: 9px;
}
.jtbd-head {
  font-family: var(--display);
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1.3;
  color: var(--ink);
  margin-bottom: 8px;
}
.jtbd-body {
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--ink-60);
}

/* Reframe split */
.reframe-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 28px;
}
.rf-before {
  background: var(--paper-2);
  border: 1px solid var(--rule);
  border-radius: 10px;
  padding: 22px;
}
.rf-after {
  background: var(--bagel-purple-soft);
  border: 1px solid var(--bagel-purple-border);
  border-radius: 10px;
  padding: 22px;
}
.rf-tag {
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  font-weight: 600;
  display: block;
  margin-bottom: 12px;
}
.rf-before .rf-tag { color: var(--ink-40); }
.rf-after .rf-tag  { color: var(--bagel-purple); }
.rf-title {
  font-family: var(--display);
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
  margin-bottom: 14px;
}
.rf-item {
  font-size: 0.83rem;
  line-height: 1.6;
  color: var(--ink-60);
  padding: 7px 0;
  border-top: 1px solid var(--rule-soft);
}
.rf-item:first-of-type { border-top: none; padding-top: 0; }
.rf-item strong { color: var(--ink); font-weight: 600; }

/* Video frame container */
.video-container {
  width: 100%;
  background: #0e0e14;
  border-radius: 12px;
  overflow: hidden;
  margin-top: 8px;
  border: 1px solid #e0e0e0;
}
.video-container video {
  width: 100%;
  display: block;
}

/* Frame below video */
.video-frame-still {
  margin-top: 12px;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid var(--rule);
}
.video-frame-still img {
  width: 100%;
  display: block;
}
.frame-label {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-40);
  margin-top: 8px;
  display: block;
}

/* Decision 03 two-frame strip */
.two-frame-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 28px;
}
.two-frame-strip .frame-item { display: flex; flex-direction: column; gap: 6px; }
.two-frame-strip img {
  width: 100%;
  display: block;
  border-radius: 8px;
  border: 1px solid var(--rule);
}
.two-frame-strip .frame-n {
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--bagel-purple);
}
.two-frame-strip .frame-cap {
  font-size: 0.78rem;
  line-height: 1.45;
  color: var(--ink-60);
}

/* Disconnect diagram */
.disconnect {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 24px;
}
.d-node {
  background: var(--paper);
  border: 1px solid var(--rule);
  border-radius: 7px;
  padding: 8px 14px;
  font-size: 0.82rem;
  font-weight: 500;
}
.d-node.dest {
  border-color: var(--bagel-purple-border);
  color: var(--bagel-purple);
  opacity: 0.5;
  background: var(--bagel-purple-soft);
}
.d-arr { font-size: 0.75rem; color: var(--ink-40); }
.no-path {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: #d94f4f;
  font-weight: 600;
  letter-spacing: 0.05em;
}

/* Quote cards */
.quote-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 28px;
}
.q-card {
  background: var(--paper);
  border: 1px solid var(--rule-soft);
  border-radius: 10px;
  padding: 20px;
}
.q-card blockquote {
  font-size: 0.9rem;
  line-height: 1.65;
  font-style: italic;
  color: var(--ink);
  margin: 0 0 10px;
}
.q-card cite {
  font-family: var(--mono);
  font-size: 0.72rem;
  color: var(--ink-60);
  font-style: normal;
}

/* Outcome cards */
.outcome-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 28px;
}
.o-card {
  background: var(--bagel-purple-soft);
  border: 1px solid var(--bagel-purple-border);
  border-radius: 10px;
  padding: 20px;
}
.o-num {
  font-family: var(--display);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--bagel-purple);
  line-height: 1;
  margin-bottom: 7px;
}
.o-lbl {
  font-size: 0.8rem;
  line-height: 1.5;
  color: var(--ink-60);
}

/* Flow section label */
.flow-mono {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--bagel-purple);
  display: block;
  margin-bottom: 20px;
}

/* Decision label */
.decision-mono {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-40);
  display: block;
  margin-bottom: 16px;
}

/* ════════════════════════════
   ACT DIVIDERS
════════════════════════════ */
.act-divider {
  padding: 56px var(--gutter) 48px;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  background: var(--paper);
  display: flex;
  align-items: baseline;
  gap: 24px;
}
.act-num {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-40);
  white-space: nowrap;
  padding-top: 6px;
}
.act-title {
  font-family: var(--display);
  font-size: clamp(2.4rem, 6vw, 5.2rem);
  font-weight: 300;
  line-height: 1.04;
  letter-spacing: -0.03em;
  color: var(--ink);
}
.jtbd-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--bagel-purple-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
}
.jtbd-icon svg {
  width: 18px;
  height: 18px;
  stroke: var(--bagel-purple);
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ════════════════════════════
   PASSWORD GATE
════════════════════════════ */
#bagel-gate {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--paper);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.gate-wordmark {
  font-family: var(--display);
  font-size: 17px;
  letter-spacing: -0.02em;
  font-weight: 400;
  color: var(--ink);
  margin-bottom: 48px;
}
.gate-inner {
  width: 280px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.gate-label {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-40);
  margin-bottom: 2px;
}
.gate-input {
  font-family: var(--body);
  font-size: 16px;
  padding: 12px 14px;
  border: 1px solid var(--rule);
  border-radius: 8px;
  background: var(--paper);
  color: var(--ink);
  outline: none;
  width: 100%;
  transition: border-color 0.15s;
}
.gate-input:focus { border-color: oklch(14% 0.01 240 / 0.4); }
.gate-btn {
  font-family: var(--body);
  font-size: 14px;
  font-weight: 500;
  padding: 12px 14px;
  background: var(--ink);
  color: #fff;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: opacity 0.15s;
  width: 100%;
}
.gate-btn:hover { opacity: 0.8; }
.gate-error {
  font-size: 13px;
  color: var(--ink-60);
  min-height: 18px;
  font-family: var(--body);
}

/* ════════════════════════════
   RESPONSIVE
════════════════════════════ */
@media (max-width: 900px) {
  :root { --gutter: 5%; }
  .two-col  { grid-template-columns: 1fr; gap: 40px; }
  .feat-split { grid-template-columns: 1fr; gap: 32px; }
  .jtbd-grid  { grid-template-columns: 1fr 1fr; }
  .reframe-split { grid-template-columns: 1fr; }
  .quote-grid    { grid-template-columns: 1fr; }
  .outcome-grid  { grid-template-columns: 1fr; }
  .meta-row      { grid-template-columns: 1fr 1fr; }
  .stat-row      { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  :root { --gutter: 20px; }
  .meta-row   { grid-template-columns: 1fr; gap: 24px; }
  .jtbd-grid  { grid-template-columns: 1fr; }
  .two-frame-strip { grid-template-columns: 1fr; }
  .stat-row   { grid-template-columns: 1fr; }
  .disconnect { gap: 6px; }
}

  </style>
</head>
<body>

<!-- ══════════════════════════════════════
     PASSWORD GATE
══════════════════════════════════════ -->
<div id="bagel-gate">
  <div class="gate-wordmark">Dana Kreisberg</div>
  <div class="gate-inner">
    <div class="gate-label">Password required</div>
    <input id="bagel-pw" class="gate-input" type="password" placeholder="Enter password" autocomplete="off">
    <div id="bagel-err" class="gate-error"></div>
    <button id="bagel-btn" class="gate-btn">Continue →</button>
  </div>
</div>

<script>
  (function () {
    const PASSWORD = '303724';
    const KEY = 'bagel-auth';
    const gate = document.getElementById('bagel-gate');
    const input = document.getElementById('bagel-pw');
    const btn   = document.getElementById('bagel-btn');
    const err   = document.getElementById('bagel-err');

    function unlock() {
      sessionStorage.setItem(KEY, 'true');
      gate.style.display = 'none';
      document.getElementById('bagel-main').style.display = '';
    }

    /* Already authenticated this session */
    if (sessionStorage.getItem(KEY) === 'true') {
      gate.style.display = 'none';
      return; /* main is visible by default when no gate */
    }

    /* Hide page content until unlocked */
    document.getElementById('bagel-main').style.display = 'none';

    btn.onclick = function () {
      if (input.value === PASSWORD) {
        unlock();
      } else {
        err.textContent = 'Incorrect password';
        input.focus();
      }
    };
    input.onkeydown = function (e) { if (e.key === 'Enter') btn.click(); };
  })();
</script>

<div id="bagel-main">

<Nav />

<!-- ══════════════════════════════════════
     HERO
══════════════════════════════════════ -->
<section class="title-section">
  <div class="title-meta">
    <span class="mono">Case Study · Bagel.AI</span>
  </div>
  <h1 class="cs-h1">Discovery <em>2.0</em></h1>
  <p class="lede">Bagel.AI surfaces customer evidence for product teams. Discovery was the most powerful space in the product — and the least used. We redesigned it from the ground up.</p>
  <div class="meta-row">
    <div>
      <span class="meta">Role</span>
      <div class="meta-val">UX Design &amp; Strategy</div>
    </div>
    <div>
      <span class="meta">Scope</span>
      <div class="meta-val">End-to-end product redesign</div>
    </div>
    <div>
      <span class="meta">Year</span>
      <div class="meta-val">2025 · NDA</div>
    </div>
  </div>
</section>

<div style="padding: 0 var(--gutter) 80px; background: #ffffff;">
  <div class="img-frame">
    <img src="/images/bagel-01.png" alt="Bagel.AI Discovery 2.0">
  </div>
</div>

<!-- ══════════════════════════════════════
     § 02 · PROBLEM
══════════════════════════════════════ -->

<section class="section-alt">
  <h2 class="cs-h2-wide">The most powerful space in the product was barely used.</h2>
  <div class="stat-row">
    <div class="stat">
      <div class="stat-n">248</div>
      <div class="stat-l">Total Discovery queries across all accounts</div>
    </div>
    <div class="stat">
      <div class="stat-n">4.4<span class="stat-d">%</span></div>
      <div class="stat-l">Of queries converted to an idea — the core intended action</div>
    </div>
    <div class="stat" style="border-right:0;">
      <div class="stat-n">~140</div>
      <div class="stat-l">Avg. weekly Idea page views, vs. near-zero for Discovery</div>
    </div>
  </div>

  <div class="img-frame" style="margin-top: 48px;">
    <img src="/images/bagel-02.jpg" alt="Old Discovery space — blank search prompt, no path to action">
    <div class="fig-cap">The old Discovery space — a blank search prompt with no starting point and no path to action.</div>
  </div>
</section>

<!-- ══════════════════════════════════════
     § 04 · RESEARCH
══════════════════════════════════════ -->
<div class="act-divider" style="background: var(--paper-2);">
  <span class="act-num">Part 01</span>
  <h2 class="act-title">Research</h2>
</div>

<section class="section-alt">
  <h2 class="cs-h2-wide">Mapping PM workflows from the ground up</h2>

