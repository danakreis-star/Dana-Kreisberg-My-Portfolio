══════════════════════════════════════ -->
<section class="section">
  <span class="decision-mono">Design Decision 01</span>
  <h2 class="cs-h2" style="margin-bottom:20px; max-width: none;">Hierarchy over navigation.</h2>
  <p class="body-text" style="max-width: none;">Information unfolds in layers: Theme → Sub-theme → Evidence. A single tap opens a searchable index of every insight in the session — no navigating away, just drilling deeper into what's already in front of you.</p>
  <div class="img-frame" style="margin-top:48px;">
    <img src="/images/bagel-04.png" alt="Hierarchy — drill-down insight view" style="border: none;">
    <div class="fig-cap">Theme → Sub-theme → Insight → Evidence — information unfolds in layers without leaving the view.</div>
  </div>
</section>

<!-- ══════════════════════════════════════
     § 06 · DESIGN DECISION 02
══════════════════════════════════════ -->
<section class="section-alt" style="background: #ffffff;">
  <div class="feat-split">
    <div>
      <span class="decision-mono">Design Decision 02</span>
      <h2 class="cs-h2" style="margin-bottom:20px; max-width: none;">Act on any insight without leaving the view.</h2>
      <p class="body-text" style="max-width: none;">Every insight card is a decision point. From within the view, create a new idea, add findings to an existing one, or duplicate for further exploration.</p>
    </div>
    <div class="img-frame">
      <img src="/images/bagel-05.png" alt="Context-aware actions — widget-level interactions" style="border: none; max-width: 600px;">
      <div class="fig-cap">Insight-level actions — scoped to the card's data, triggered without switching views.</div>
    </div>
  </div>
</section>

